{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "statementiq-site",
  "main": "src/index.js",
  "compatibility_date": "2026-09-20",
  "routes": [
    {
      "pattern": "statementiq-lb.com",
      "custom_domain": true
    },
    {
      "pattern": "www.statementiq-lb.com",
      "custom_domain": true
    }
  ],
  "vars": {
    "BACKEND_ORIGIN": "https://statementiq-sacc.onrender.com"
  },
  "assets": {
    "directory": "./static",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "upload_source_maps": true,
  "version_metadata": {"binding": "CF_VERSION_METADATA"},
  "d1_databases": [{
    "binding": "RESEARCH_DB",
    "database_name": "statementiq-research",
    "database_id": "e522acef-346c-4879-bd23-230d6f3762ca",
    "migrations_dir": "migrations"
  }],
  "triggers": {"crons": ["*/30 * * * *"]}
}
